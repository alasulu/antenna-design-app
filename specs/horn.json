    {
      "key": "conical_horn",
      "name": "Conical horn (optimum gain)",
      "family": "horn",
      "summary": "Circular waveguide flared into a cone; the standard reflector feed.",
      "freq_range_hz": [
        1000000000.0,
        300000000000.0
      ],
      "parameters": [
        {
          "symbol": "f0",
          "name": "design frequency",
          "unit": "Hz",
          "role": "requirement"
        },
        {
          "symbol": "L",
          "name": "axial flare length",
          "unit": "m",
          "role": "requirement",
          "typical": "0.3"
        },
        {
          "symbol": "dm",
          "name": "aperture diameter",
          "unit": "m",
          "role": "geometry"
        }
      ],
      "synthesis": [
        {
          "output": "dm",
          "expr": "np.sqrt(3*(c/f0)*L)",
          "units_out": "m",
          "depends_on": [
            "f0",
            "L"
          ],
          "notes": "optimum-gain condition d_m = sqrt(3*lambda*L)"
        }
      ],
      "analysis": [
        {
          "metric": "gain_dbi",
          "expr": "db10(0.51*4*pi*(pi*dm**2/4)*(f0/c)**2)",
          "units_out": "dBi",
          "depends_on": [
            "dm",
            "f0"
          ],
          "notes": "aperture efficiency 0.51, as for the pyramidal horn"
        },
        {
          "metric": "aperture_efficiency",
          "expr": "0.51",
          "units_out": "-"
        },
        {
          "metric": "hpbw_e_deg",
          "expr": "60.0/(dm*f0/c)",
          "units_out": "deg",
          "depends_on": [
            "dm",
            "f0"
          ],
          "notes": "approximately 60*lambda/d_m; the conical horn's E- and H-plane beamwidths differ by roughly 10%, which is why cross-polarisation is poor"
        },
        {
          "metric": "hpbw_h_deg",
          "expr": "70.0/(dm*f0/c)",
          "units_out": "deg",
          "depends_on": [
            "dm",
            "f0"
          ]
        }
      ],
      "validity": [
        "optimum flare only",
        "TE11 dominant mode",
        "asymmetric pattern and high cross-polarisation; use a corrugated horn where pattern symmetry matters"
      ],
      "known_cases": [
        {
          "given": {
            "f0": 10000000000.0,
            "L": 0.3
          },
          "expect": {
            "dm_m": 0.1642,
            "gain_dbi": 21.55
          },
          "tol_pct": 1.5,
          "source": "d_m = sqrt(3*lambda*L) = 164.2 mm at 10 GHz, L = 0.3 m; G = 0.51*4*pi*A/lambda^2. Balanis, Antenna Theory 4th ed., Ch. 13"
        }
      ],
      "references": [
        "Balanis, Antenna Theory 4th ed., Ch. 13 (13.5)"
      ]
    },
    {
      "key": "corrugated_conical_horn",
      "name": "Corrugated (scalar) conical horn",
      "family": "horn",
      "summary": "Conical horn with lambda/4 corrugations, giving a symmetric HE11 balanced-hybrid pattern.",
      "freq_range_hz": [
        1000000000.0,
        300000000000.0
      ],
      "parameters": [
        {
          "symbol": "f0",
          "name": "design frequency",
          "unit": "Hz",
          "role": "requirement"
        },
        {
          "symbol": "L",
          "name": "axial flare length",
          "unit": "m",
          "role": "requirement",
          "typical": "0.3"
        },
        {
          "symbol": "dm",
          "name": "aperture diameter",
          "unit": "m",
          "role": "geometry"
        },
        {
          "symbol": "slot_depth",
          "name": "corrugation depth",
          "unit": "m",
          "role": "geometry"
        }
      ],
      "synthesis": [
        {
          "output": "dm",
          "expr": "np.sqrt(3*(c/f0)*L)",
          "units_out": "m",
          "depends_on": [
            "f0",
            "L"
          ]
        },
        {
          "output": "slot_depth",
          "expr": "0.25*c/f0",
          "units_out": "m",
          "depends_on": [
            "f0"
          ],
          "notes": "lambda/4 slots present a high surface impedance, which is what enforces the balanced-hybrid HE11 condition. Depth must hold across the band, so wideband designs taper it from lambda/2 at the throat to lambda/4 at the aperture."
        }
      ],
      "analysis": [
        {
          "metric": "gain_dbi",
          "expr": "db10(0.69*4*pi*(pi*dm**2/4)*(f0/c)**2)",
          "units_out": "dBi",
          "depends_on": [
            "dm",
            "f0"
          ],
          "notes": "aperture efficiency 0.69, materially better than the 0.51 of a smooth-wall horn"
        },
        {
          "metric": "aperture_efficiency",
          "expr": "0.69",
          "units_out": "-"
        },
        {
          "metric": "hpbw_deg",
          "expr": "66.0/(dm*f0/c)",
          "units_out": "deg",
          "depends_on": [
            "dm",
            "f0"
          ],
          "notes": "the same in both planes, which is the whole point of the corrugations"
        },
        {
          "metric": "cross_pol_db",
          "expr": "-30.0",
          "units_out": "dB",
          "notes": "Indicative: well-made corrugated horns reach -30 dB or better across the design band"
        },
        {
          "metric": "gain_advantage_over_smooth_db",
          "expr": "db10(0.69/0.51)",
          "units_out": "dB"
        }
      ],
      "validity": [
        "at least 5 corrugations per wavelength; below that the surface-impedance model fails",
        "balanced-hybrid condition holds over roughly an octave; wider needs a tapered slot depth",
        "cross-polarisation figure is indicative, not derived"
      ],
      "known_cases": [
        {
          "given": {
            "f0": 10000000000.0,
            "L": 0.3
          },
          "expect": {
            "dm_m": 0.1642,
            "slot_depth_m": 0.0074948,
            "gain_advantage_over_smooth_db": 1.3155
          },
          "tol_pct": 1.5,
          "source": "Same aperture as the smooth conical horn, lambda/4 = 7.49 mm slots, and 10*log10(0.69/0.51) = 1.32 dB of aperture-efficiency advantage. Clarricoats & Olver, Corrugated Horns for Microwave Antennas"
        }
      ],
      "references": [
        "Clarricoats & Olver, Corrugated Horns for Microwave Antennas",
        "Balanis, Antenna Theory 4th ed., Ch. 13 (13.6)"
      ]
    },
    {
      "key": "open_ended_waveguide",
      "name": "Open-ended rectangular waveguide",
      "family": "horn",
      "summary": "Unflared waveguide aperture; the low-gain limit of the horn family.",
      "freq_range_hz": [
        300000000.0,
        300000000000.0
      ],
      "parameters": [
        {
          "symbol": "f0",
          "name": "design frequency",
          "unit": "Hz",
          "role": "requirement"
        },
        {
          "symbol": "a_wg",
          "name": "broad wall",
          "unit": "m",
          "role": "requirement",
          "typical": "0.02286"
        },
        {
          "symbol": "b_wg",
          "name": "narrow wall",
          "unit": "m",
          "role": "requirement",
          "typical": "0.01016"
        }
      ],
      "synthesis": [],
      "analysis": [
        {
          "metric": "aperture_efficiency",
          "expr": "8/pi**2",
          "units_out": "-",
          "notes": "exactly 8/pi^2 = 0.8106 for the TE10 cosine distribution across a, uniform across b"
        },
        {
          "metric": "gain_dbi",
          "expr": "db10((8/pi**2)*4*pi*a_wg*b_wg*(f0/c)**2)",
          "units_out": "dBi",
          "depends_on": [
            "a_wg",
            "b_wg",
            "f0"
          ],
          "notes": "ignores the aperture mismatch, which is significant for an unflared guide"
        },
        {
          "metric": "cutoff_te10_hz",
          "expr": "c/(2*a_wg)",
          "units_out": "Hz",
          "depends_on": [
            "a_wg"
          ]
        },
        {
          "metric": "guide_wavelength_m",
          "expr": "(c/f0)/np.sqrt(1 - (c/(2*a_wg*f0))**2)",
          "units_out": "m",
          "depends_on": [
            "f0",
            "a_wg"
          ],
          "notes": "TE10 guide wavelength; diverges at cutoff"
        }
      ],
      "validity": [
        "single-mode TE10 operation: f0 between the TE10 and TE20 cutoffs",
        "aperture reflection is neglected, so the gain figure is optimistic by a few tenths of a dB",
        "an infinite ground plane is assumed; a bare guide end radiates backward as well"
      ],
      "known_cases": [
        {
          "given": {
            "f0": 10000000000.0,
            "a_wg": 0.02286,
            "b_wg": 0.01016
          },
          "expect": {
            "cutoff_te10_hz": 6555900000.0,
            "aperture_efficiency": 0.81057,
            "gain_dbi": 4.2033
          },
          "tol_pct": 1.0,
          "source": "WR-90 (22.86 x 10.16 mm) at 10 GHz: TE10 cutoff = c/(2a) = 6.556 GHz; aperture is only 0.76 x 0.34 lambda, so G = (8/pi^2)*4*pi*A/lambda^2 = 4.20 dBi. Published ~6 dBi figures for open-ended guide usually include a flange. Balanis, Antenna Theory 4th ed., Ch. 13"
        }
      ],
      "references": [
        "Balanis, Antenna Theory 4th ed., Ch. 13 (13.1)",
        "Pozar, Microwave Engineering 4th ed., Ch. 3"
      ]
    }
  ]
}