{
  // GitHub Codespaces: the toolkit with its desktop GUI on a virtual screen,
  // shown in the browser through noVNC on port 6080 (password: vscode).
  "name": "OTA Hub Antenna Toolkit",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "containerEnv": {
    "DISPLAY": ":1",
    "VNC_RESOLUTION": "1600x1000x24"
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Antenna app (desktop)",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start-gui.sh",
  "customizations": {
    "codespaces": {
      "openFiles": [".devcontainer/README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
